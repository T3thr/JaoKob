  "prototypes": {
    "dialogue.act1.first-light": "ก่อนโลกจะมีชื่อ โลกคือแสงที่ไหวอยู่เหนือผิวน้ำ และจังหวะคุ้นเคยที่ว่ายอยู่ข้างกัน",
    "dialogue.act1.mother-roots": "ถ้าน้ำไหว ให้ฟังรากบัวนะ รากจำทางกลับได้ดีกว่าคลื่น",
    "dialogue.act1.voice-of-home": "เสียงของบ้านอยู่ตรงไหน หรือเสียงของเรากำลังไหลไปไกลกว่าเดิม",
    "dialogue.act1.leaf-memory": "ใบบัวชิ้นเล็กไม่ใช่บ้านทั้งหลัง แต่มันยังจำสีของบ้านได้",
    "dialogue.act1.coping-call": "เจ้ากบเรียกจนเสียงบางลง แต่การเรียกนั้นยืนยันว่าบ้านเคยมีอยู่จริง",
    "dialogue.act1.coping-safety": "เจ้ากบหาช่องหายใจก่อน แล้วจึงปล่อยให้ความคิดถึงตามมาทัน"
  },
